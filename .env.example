# ---- Banco de dados (Vercel Postgres) ----
# Preenchidos automaticamente pela Vercel quando você conecta o Postgres ao projeto.
# Para rodar local, copie os valores da aba Storage > Postgres > .env.local no dashboard da Vercel.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# ---- Autenticação simples (login único) ----
APP_USERNAME="admin"
APP_PASSWORD="troque-esta-senha"
# Gere um valor aleatório longo, ex: openssl rand -hex 32
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# ---- Google Cloud / BigQuery ----
# JSON da service account convertido para base64 (uma linha só).
# No Linux/Mac: base64 -i sua-chave.json | tr -d '\n'
GOOGLE_CREDENTIALS_BASE64=""
BIGQUERY_TABLE="igneous-ethos-444918-p4.BISCOITE.biscoite_bronze"
BIGQUERY_LOCATION="US"
